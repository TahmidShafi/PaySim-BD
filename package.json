{
  "name": "paysim-bd",
  "version": "0.1.0",
  "description": "Local CLI and chaos webhook simulator for bKash Tokenized Checkout and AWS SNS IPN",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "paysim": "./dist/src/cli/index.js"
  },
  "scripts": {
    "build": "tsc && node scripts/copy-assets.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "paysim": "npx tsx src/cli/index.ts",
    "benchmark": "npx tsx scripts/benchmark.ts",
    "demo": "npx tsx scripts/demo.ts"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "commander": "^13.1.0",
    "fastify": "^5.2.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.4",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
